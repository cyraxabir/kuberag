    {
      "parameters": {
        "jsCode": "const results = $json.result || [];\nconst query = $('Chat Trigger').first().json.chatInput;\n\nconst SYSTEM_PROMPT = `You are an expert Kubernetes AI assistant integrated with a RAG system.\n\nRules:\n- ONLY answer based on the retrieved context provided. Never hallucinate cluster state.\n- If context is empty or irrelevant, respond exactly: \"No indexed Kubernetes resources found in vector database.\"\n- Use markdown tables for structured/aggregated data.\n- Do not expose internal resource_uid values.\n- Be concise and technical.`;\n\nlet userMessage;\nif (results.length === 0) {\n  userMessage = `No resources were retrieved from the vector database.\\n\\nUser question: ${query}`;\n} else {\n  const ctx = results\n    .map((r, i) => {\n      const p = r.payload;\n      const spec = p.raw_spec_json ? p.raw_spec_json.substring(0, 300) : '{}';\n      const labels = JSON.stringify(p.labels || {});\n      return `[${i + 1}] kind=${p.kind}  name=${p.name}  namespace=${p.namespace || '(cluster-scoped)'}  labels=${labels}  score=${r.score.toFixed(3)}  spec=${spec}`;\n    })\n    .join('\\n');\n  userMessage = `Retrieved ${results.length} Kubernetes resources:\\n\\n${ctx}\\n\\nUser question: ${query}`;\n}\n\nreturn [{ json: { system_prompt: SYSTEM_PROMPT, user_message: userMessage } }];"
      },
      "id": "e5899bb1-18b6-4a26-8183-ef6c6fac70f4",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
